export type IconName = keyof typeof icons | keyof typeof brand;

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  label?: string;
}
const { name, size = 20, class: className, label } = Astro.props;
const isBrand = name in brand;
const body = isBrand ? brand[name as keyof typeof brand] : icons[name as keyof typeof icons];
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke={isBrand ? 'none' : 'currentColor'}
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden={label ? undefined : 'true'}
  aria-label={label}
  role={label ? 'img' : undefined}
  set:html={body}
/>
