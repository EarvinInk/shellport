---
import { u } from "../lib/url";
import Icon, { type IconName } from './Icon.astro';
import AppWindow from './AppWindow.astro';
import Illustration from './Illustration.astro';
import terminal from '../assets/screenshots/terminal.png';
import sftp from '../assets/screenshots/sftp.png';
import logs from '../assets/screenshots/logs.png';
import vault from '../assets/screenshots/vault.png';

type Tab = {
  id: string; icon: IconName; label: string; title: string; body: string; points: string[]; doc: string;
} & ({ img: ImageMetadata; alt: string } | { illustration: 'sql' | 'hosts' });

const tabs: Tab[] = [
  {
    id: 'terminals', icon: 'terminal', label: 'Terminals',
    title: 'Every server, one click away',
    body: 'Save hosts in colour-coded groups and connect with a double-click. Sessions reconnect on their own after sleep or a network change.',
    points: ['Password, vault key, key file or ssh-agent; jump hosts and 2FA', 'Command palette (Ctrl+Shift+P) for every host, tab and action', 'Two-way sync with ~/.ssh/config, optional tmux sessions'],
    img: terminal, alt: 'Tabbed SSH terminal with grouped saved hosts', doc: '/docs/hosts-and-ssh/',
  },
  {
    id: 'across', icon: 'network', label: 'Across servers',
    title: 'One command, every server',
    body: 'Run a command on many hosts at once and get a pass/fail line and output for each. Split panes and broadcast typing cover the interactive work.',
    points: ['Split panes, saved as workspaces', 'Commands library with {{variables}}', 'Production hosts always ask first'],
    illustration: 'hosts', doc: '/docs/work-across-servers/',
  },
  {
    id: 'files', icon: 'folder', label: 'Files',
    title: 'Move and edit files without leaving the app',
    body: 'A dual-pane local ↔ remote browser with one transfer queue for every tab: pause, resume and retry, even after a dropped connection.',
    points: ['Copy straight from one server to another', 'Edit remote files, or open them in your own editor', 'Work as root with sudo; compress and extract'],
    img: sftp, alt: 'Dual-pane SFTP file manager', doc: '/docs/sftp/',
  },
  {
    id: 'docker', icon: 'box', label: 'Docker',
    title: 'Containers, local or over SSH',
    body: 'Manage the local engine or any server you can SSH into, with no Docker port exposed. Follow a whole Compose project’s logs, merged and colour-coded.',
    points: ['Start, stop, restart, open a shell', 'Images, volumes, networks and cleanup', 'Pull from private registries'],
    img: logs, alt: 'Merged, colour-coded logs from all containers of a Compose project', doc: '/docs/docker/',
  },
  {
    id: 'databases', icon: 'database', label: 'Databases',
    title: 'PostgreSQL, straight through SSH',
    body: 'A built-in client with a schema browser, SQL editor and fast result grid. Connect directly or through any saved host, jump hosts included.',
    points: ['Read-only or “confirm risky” per connection', 'Open-transaction indicator with Commit / Rollback', 'Works behind PgBouncer and Supabase poolers'],
    illustration: 'sql', doc: '/docs/databases/',
  },
  {
    id: 'vault', icon: 'shield', label: 'Vault',
    title: 'Secrets that stay yours',
    body: 'Passwords, private keys, database credentials and API tokens live in one encrypted file, unlocked by a master password only you know.',
    points: ['Argon2id + XChaCha20-Poly1305', 'Generate ed25519 keys in-app', 'Encrypted backup & restore for a new machine'],
    img: vault, alt: 'The vault holding passwords and a private key', doc: '/docs/vault/',
  },
];
---
<section class="section showcase" id="features">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Everything in one place</span>
      <h2>Stop juggling tools to ship one fix</h2>
      <p>Terminals, file transfers, containers, databases and secrets, built to work together.</p>
    </div>

    <div class="tabs reveal" role="tablist" aria-label="Shellport features">
      {tabs.map((t, i) => (
        <button role="tab" id={`tab-${t.id}`} aria-controls={`panel-${t.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
          <Icon name={t.icon} size={17} />{t.label}
        </button>
      ))}
    </div>

    <div class="panels reveal">
      {tabs.map((t, i) => (
        <div class="panel" role="tabpanel" id={`panel-${t.id}`} aria-labelledby={`tab-${t.id}`} hidden={i !== 0}>
          <div class="text">
            <div class="icon-badge"><Icon name={t.icon} /></div>
            <h3>{t.title}</h3>
            <p>{t.body}</p>
            <ul>{t.points.map((p) => <li><Icon name="check" size={16} />{p}</li>)}</ul>
            <a class="more" href={u(t.doc)}>Read the guide <Icon name="arrowRight" size={15} /></a>
          </div>
          <div class="shot">{'img' in t
            ? <AppWindow src={t.img} alt={t.alt} title={`Shellport — ${t.label}`} />
            : <Illustration kind={t.illustration} />}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .tabs {
    display: flex; gap: 4px; padding: 5px; margin: 0 auto 40px; width: fit-content; max-width: 100%;
    background: var(--surface-1); border: 1px solid var(--border); border-radius: 14px;
    overflow-x: auto; scrollbar-width: none;
  }
  .tabs::-webkit-scrollbar { display: none; }
  [role='tab'] {
    display: flex; align-items: center; gap: 8px; flex: none;
    padding: 9px 18px; border: 0; border-radius: 10px; background: none;
    color: var(--fg-muted); font-size: 14.5px; font-weight: 550; cursor: pointer;
    transition: color .2s, background .2s;
  }
  [role='tab']:hover { color: var(--fg); }
  [role='tab'][aria-selected='true'] { background: var(--surface-3); color: var(--fg); box-shadow: 0 1px 0 rgba(255,255,255,.05) inset; }
  [role='tab'][aria-selected='true'] :global(svg) { color: var(--accent-soft); }

  .panel { display: grid; grid-template-columns: 0.72fr 1.6fr; gap: 56px; align-items: center; animation: fade .45s ease; }
  .panel[hidden] { display: none; }
  .panel > * { min-width: 0; }
  @keyframes fade { from { opacity: 0; transform: translateY(8px); } }
  .text h3 { font-size: 28px; margin: 22px 0 14px; }
  .text p { color: var(--fg-muted); font-size: 16.5px; }
  .text ul { list-style: none; padding: 0; margin: 22px 0 26px; display: grid; gap: 11px; }
  .text li { display: flex; gap: 10px; align-items: flex-start; font-size: 15px; }
  .text li :global(svg) { color: var(--accent-soft); margin-top: 4px; flex: none; }
  .more { display: inline-flex; align-items: center; gap: 6px; font-weight: 560; color: var(--accent-soft); }
  .more:hover { gap: 9px; }
  .more { transition: gap .2s; }
  @media (max-width: 960px) {
    .panel { grid-template-columns: 1fr; gap: 32px; }
    .shot { order: -1; }
  }
</style>

<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.showcase [role="tab"]'));
  const select = (tab: HTMLButtonElement, focus = false) => {
    for (const t of tabs) {
      const on = t === tab;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on;
    }
    if (focus) tab.focus();
    tab.scrollIntoView({ block: 'nearest', inline: 'nearest' });
  };
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => select(t));
    t.addEventListener('keydown', (e) => {
      const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (d) { e.preventDefault(); select(tabs[(i + d + tabs.length) % tabs.length], true); }
    });
  });
</script>
