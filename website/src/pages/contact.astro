---
import { u } from '../lib/url';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon, { type IconName } from '../components/Icon.astro';
import { site } from '../site.config';

const allChannels: { icon: IconName; title: string; body: string; cta: string; href: string; tone?: string }[] = [
  { icon: 'bug', title: 'Report a bug', body: 'Something broken or behaving oddly? Open an issue with steps to reproduce, and we’ll take a look.', cta: 'Open a bug report', href: site.links.newBug },
  { icon: 'bulb', title: 'Request a feature', body: 'Have an idea that would make Shellport better for your workflow? Tell us what you need and why.', cta: 'Suggest a feature', href: site.links.newFeature },
  { icon: 'message', title: 'Ask the community', body: 'Questions about setup, configuration or how to do something? Start a discussion and get help.', cta: 'Join the discussion', href: site.links.discussions },
  { icon: 'shieldAlert', title: 'Report a vulnerability', body: 'Found a security issue? Please report it privately so it can be fixed before it’s disclosed.', cta: 'Report privately', href: site.links.security, tone: 'danger' },
];

const channels = allChannels.filter((c) => c.href);

const faqs = [
  { q: 'Does Shellport collect any data?', a: 'No. There is no telemetry, no account and no cloud service. The app only connects to servers and Docker engines you add.' },
  { q: 'Will there be macOS or Windows versions?', a: 'Shellport is focused on Linux for now. If you’d like another platform, upvote or open a feature request so demand is visible.' },
  { q: 'I forgot my vault master password. Can you recover it?', a: 'Unfortunately not. The vault is encrypted with a key derived from your password and nobody else has a copy. You can delete vault.bin and start fresh.' },
  { q: 'Can I use Shellport at work?', a: 'Yes. It’s MIT-licensed, so you can use it personally and commercially at no cost.' },
];
---
<Base title="Contact" description="Get help with Shellport, report bugs, request features or report a security issue.">
  <PageHeader
    eyebrow="Contact & support"
    title="We’d love to hear from you"
    lead="Bug reports, feature ideas, questions and kind words are all welcome. Pick the channel that fits best."
  />

  <section class="container channels">
    {channels.map((c, i) => (
      <a class:list={['card', 'channel', 'reveal', c.tone]} href={c.href} rel="noopener" style={`transition-delay:${i * 60}ms`}>
        <div class="icon-badge"><Icon name={c.icon} /></div>
        <h2>{c.title}</h2>
        <p>{c.body}</p>
        <span class="go">{c.cta} <Icon name="arrowRight" size={15} /></span>
      </a>
    ))}
  </section>

  {site.author.email && (
  <section class="container direct-wrap">
    <div class="direct reveal">
      <div class="direct-icon"><Icon name="mail" size={26} /></div>
      <div class="direct-text">
        <h2>Prefer email?</h2>
        <p class="muted">For partnerships, press, or anything that doesn’t belong in a public issue. Usually answered within a few days.</p>
      </div>
      <a class="btn btn-primary btn-lg" href={`mailto:${site.author.email}?subject=Shellport`}><Icon name="mail" />{site.author.email}</a>
    </div>
  </section>
  )}

  <section class="section faq">
    <div class="container narrow">
      <div class="section-head reveal">
        <span class="eyebrow">FAQ</span>
        <h2>Quick answers</h2>
      </div>
      <div class="faq-list reveal">
        {faqs.map((f) => (
          <details>
            <summary>{f.q}<Icon name="chevronDown" size={18} /></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
      <p class="more muted">Looking for setup help? The <a href={u('/docs/')}>documentation</a> and <a href={u('/docs/troubleshooting/')}>troubleshooting guide</a> cover most questions.</p>
    </div>
  </section>
</Base>

<style>
  .channels { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; max-width: 1040px; }
  .channel { display: flex; flex-direction: column; padding: 32px; }
  .channel h2 { font-size: 21px; margin: 20px 0 10px; }
  .channel p { color: var(--fg-muted); font-size: 15px; margin-bottom: 22px; }
  .go { margin-top: auto; display: inline-flex; align-items: center; gap: 6px; font-weight: 580; font-size: 14.5px; color: var(--accent-soft); transition: gap .2s; }
  .channel:hover .go { gap: 10px; }
  .danger .icon-badge { background: rgba(244, 63, 94, .1); color: #fb7185; border-color: rgba(244, 63, 94, .25); }
  .danger .go { color: #fb7185; }
  @media (max-width: 760px) { .channels { grid-template-columns: 1fr; } .channel { padding: 26px 22px; } }

  .direct-wrap { max-width: 1040px; margin-top: 20px; }
  .direct {
    display: flex; align-items: center; gap: 24px; flex-wrap: wrap;
    padding: 32px 36px; border-radius: 20px;
    border: 1px solid color-mix(in srgb, var(--accent) 35%, var(--border));
    background: radial-gradient(ellipse 50% 120% at 0% 50%, color-mix(in srgb, var(--accent) 16%, transparent), transparent 70%), var(--surface-1);
  }
  .direct-icon { width: 60px; height: 60px; border-radius: 16px; display: grid; place-items: center; background: var(--accent-bg); color: var(--accent-soft); flex: none; }
  .direct-text { flex: 1; min-width: 240px; }
  .direct h2 { font-size: 22px; margin-bottom: 6px; }
  .direct p { font-size: 15px; }
  @media (max-width: 640px) { .direct { padding: 26px 22px; } .direct .btn { width: 100%; font-size: 15px; } }

  .narrow { max-width: 780px; }
  .faq-list { display: grid; gap: 10px; }
  details { border: 1px solid var(--border); border-radius: 14px; background: var(--surface-1); transition: border-color .2s; }
  details[open] { border-color: var(--border-strong); }
  summary {
    list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px;
    padding: 18px 22px; font-weight: 560; font-size: 16px;
  }
  summary::-webkit-details-marker { display: none; }
  summary :global(svg) { flex: none; color: var(--fg-subtle); transition: transform .25s; }
  details[open] summary :global(svg) { transform: rotate(180deg); }
  details p { padding: 0 22px 20px; color: var(--fg-muted); font-size: 15px; }
  .more { margin-top: 28px; text-align: center; font-size: 15px; }
  .more a { color: var(--accent-soft); font-weight: 550; }
</style>
